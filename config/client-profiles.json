{
  "schema_version": 1,
  "minimum_sing_box_version": "1.14.0",
  "profiles": {
    "windows": {
      "file_name": "sing-box-windows-tun.json",
      "description": "Windows TUN 配置；mixed 栈与 65535 MTU。",
      "overlay": {
        "experimental": {
          "clash_api": {
            "external_controller": "127.0.0.1:19090"
          }
        }
      },
      "tun_overlay": {
        "mtu": 65535,
        "stack": "mixed"
      }
    },
    "linux": {
      "file_name": "sing-box-linux-tun.json",
      "description": "普通 Linux TUN 配置；mixed 栈、65535 MTU、auto_redirect 与有效 IPv4 直连集合路由旁路。",
      "overlay": {},
      "linux_route_exclude_address_sets": true,
      "tun_overlay": {
        "mtu": 65535,
        "stack": "mixed",
        "auto_route": true,
        "auto_redirect": true
      }
    },
    "macos": {
      "file_name": "sing-box-macos-tun.json",
      "description": "macOS TUN 配置；NetworkExtension 使用 gvisor 与 4064 MTU。",
      "overlay": {},
      "tun_overlay": {
        "mtu": 4064,
        "stack": "gvisor"
      }
    },
    "android": {
      "file_name": "sing-box-android.json",
      "description": "Android TUN 配置；VpnService 接入、mixed 栈与 9000 MTU，不启用 Linux auto_redirect。",
      "overlay": {},
      "tun_overlay": {
        "mtu": 9000,
        "stack": "mixed"
      }
    },
    "ios": {
      "file_name": "sing-box-ios.json",
      "description": "iOS/iPadOS TUN 配置；NetworkExtension 使用 gvisor 与 4064 MTU。",
      "overlay": {},
      "tun_overlay": {
        "mtu": 4064,
        "stack": "gvisor"
      }
    }
  }
}
