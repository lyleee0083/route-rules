{
  "version": 2,
  "conflict_policy": {
    "earlier_rule": "wins",
    "later_overlap": "ordered-first-match"
  },
  "resources": [
    {
      "tag": "217heidai-adblock-dns",
      "type": "remote",
      "format": "adguard-dns",
      "url": "https://github.com/217heidai/adblockfilters/releases/download/rule/adblockdns.txt"
    },
    {
      "tag": "loyalsoldier-geosite",
      "type": "remote",
      "format": "geosite-dat",
      "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat"
    },
    {
      "tag": "loyalsoldier-geoip",
      "type": "remote",
      "format": "geoip-dat",
      "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"
    },
    {
      "tag": "aethersailor-direct-domain",
      "type": "remote",
      "format": "mrs-domain",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Direct_Domain.mrs"
    },
    {
      "tag": "aethersailor-direct-ip",
      "type": "remote",
      "format": "mrs-ipcidr",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Direct_IP.mrs"
    },
    {
      "tag": "aethersailor-direct-port",
      "type": "remote",
      "format": "clash-yaml",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Direct_Classical_Port.yaml"
    },
    {
      "tag": "aethersailor-proxy-domain",
      "type": "remote",
      "format": "mrs-domain",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Proxy_Domain.mrs"
    },
    {
      "tag": "aethersailor-proxy-ip",
      "type": "remote",
      "format": "mrs-ipcidr",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Proxy_IP.mrs"
    },
    {
      "tag": "aethersailor-steam-cdn-domain",
      "type": "remote",
      "format": "mrs-domain",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Steam_CDN_Domain.mrs"
    },
    {
      "tag": "aethersailor-steam-cdn-ip",
      "type": "remote",
      "format": "mrs-ipcidr",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Steam_CDN_IP.mrs"
    },
    {
      "tag": "aethersailor-port-direct",
      "type": "remote",
      "format": "clash-yaml",
      "url": "https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Port_Direct.yaml"
    },
    {
      "tag": "clang-cn-ipnetdb",
      "type": "remote",
      "format": "plain",
      "url": "https://ispip.clang.cn/all_cn.txt"
    },
    {
      "tag": "clang-cn-apnic",
      "type": "remote",
      "format": "plain",
      "url": "https://ispip.clang.cn/all_cn_apnic.txt"
    },
    {
      "tag": "felixonmars-cn-domains",
      "type": "remote",
      "format": "dnsmasq",
      "url": "https://raw.githubusercontent.com/felixonmars/dnsmasq-china-list/master/accelerated-domains.china.conf"
    }
  ],
  "rules": [
    {
      "id": "static-reject",
      "action": "reject",
      "inputs": [
        {
          "type": "local",
          "format": "source",
          "path": "static-reject.json"
        }
      ]
    },
    {
      "id": "remote-reject-217heidai",
      "action": "reject",
      "inputs": [
        {
          "resource": "217heidai-adblock-dns"
        }
      ]
    },
    {
      "id": "static-direct-domain",
      "action": "direct",
      "inputs": [
        {
          "type": "local",
          "format": "source",
          "path": "static-direct-domain.json"
        }
      ]
    },
    {
      "id": "static-direct-ip",
